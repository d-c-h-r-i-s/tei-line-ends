# Copy to `.secret.env` (gitignored) and fill in what you use.
# Every value here is optional; without it the feature turns itself off.

# Deep links from a finding to the page in Transkribus. A link is built from
# two ids:
#   https://beta.transkribus.org/collection/[COLLECTION_ID]/doc/[DOCUMENT_ID]/...
# The collection id is the one number for your whole collection: open the
# collection in the web app and read it out of the URL. The document ids are
# one per issue and do not belong here — they live in
# data/csv/transkribus_filenames.csv.
export TRANSKRIBUS_COLLECTION_ID=

# Push a message when a long model run finishes (https://ntfy.sh).
# Anyone who knows the topic URL can read and post to it — pick a long,
# unguessable name.
export NTFY_CHANNEL=
